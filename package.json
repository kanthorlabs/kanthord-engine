{
  "name": "kanthord",
  "version": "28.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "bin": {
    "kanthord": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "format": "prettier --write src scripts eslint.config.js",
    "lint": "eslint . .claude/skills/work/scripts",
    "start": "node src/main.ts",
    "verify": "prettier --check src scripts eslint.config.js && pnpm run typecheck && pnpm test && pnpm run lint && pnpm run verify:guards && node --test --test-timeout=120000 .claude/skills/work/scripts/work-runtime.test.mjs",
    "verify:guards": "scripts/lane-check.test.sh && scripts/turn-snapshot.test.sh && scripts/history-append-only.test.sh && scripts/persona-sync.test.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yml,yaml}": "prettier --write",
    "*.{ts,js,mjs}": "eslint --fix"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@types/node": "24.0.0",
    "@types/supertest": "7.2.1",
    "eslint": "10.7.0",
    "eslint-plugin-boundaries": "7.0.2",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "supertest": "7.2.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.63.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@hono/node-server": "2.1.1",
    "commander": "15.0.0",
    "convict": "6.2.5",
    "graphology": "0.26.0",
    "hono": "4.13.3",
    "pino": "10.3.1",
    "ulid": "3.0.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.4": true,
    "protobufjs@7.6.5": true
  }
}
