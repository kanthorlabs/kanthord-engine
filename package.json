{
  "name": "kanthord",
  "version": "27.8.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.18.0"
  },
  "packageManager": "npm@11.18.0",
  "bin": {
    "kanthord": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:cov": "node scripts/cov-reporter.mjs",
    "e2e": "node scripts/e2e/run.mjs",
    "e2e:007": "node scripts/e2e/007/run.ts",
    "format": "prettier --write src test scripts docs eslint.config.js",
    "lint": "eslint .",
    "start": "node src/main.ts",
    "verify": "npm run format && npm run typecheck && npm test && npm run lint && node scripts/verify-db-status.ts && npm run verify:guards",
    "verify:handoff": "node scripts/verify-handoff.mjs",
    "verify:guards": "scripts/lane-check.test.sh && scripts/turn-snapshot.test.sh && scripts/memory-append-only.test.sh && scripts/persona-sync.test.sh",
    "contract:publish": "node scripts/publish-contract.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yml,yaml}": "prettier --write",
    "*.{ts,js,mjs}": "eslint --fix"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@types/koa": "3.0.3",
    "@types/koa__cors": "5.0.1",
    "@types/node": "24.0.0",
    "@types/supertest": "7.2.1",
    "eslint": "10.7.0",
    "eslint-plugin-boundaries": "7.0.2",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "supertest": "7.2.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.63.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@hono/node-server": "2.1.1",
    "@koa/bodyparser": "6.1.0",
    "@koa/cors": "5.0.0",
    "commander": "15.0.0",
    "convict": "6.2.5",
    "graphology": "0.26.0",
    "hono": "4.13.3",
    "koa": "3.2.1",
    "pino": "10.3.1",
    "ulid": "3.0.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.4": true,
    "protobufjs@7.6.5": true
  }
}
