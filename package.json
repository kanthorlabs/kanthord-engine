{
  "name": "kanthord",
  "version": "28.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "bin": {
    "kanthord": "./bin/kanthord.mjs"
  },
  "files": [
    "bin",
    "dist",
    "static"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=30000 'src/**/*.test.ts'",
    "test:e2e:jwt": "pnpm run build && python3 scripts/e2e-jwt.py",
    "format": "prettier --write src bin eslint.config.js",
    "lint": "eslint src bin eslint.config.js",
    "start": "node bin/kanthord.mjs",
    "verify": "prettier --check src bin eslint.config.js && pnpm run typecheck && pnpm test && pnpm run lint && pnpm run build",
    "verify:guards": "node -e \"process.exit(0)\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yml,yaml}": "prettier --write",
    "*.{ts,js,mjs}": "eslint --fix"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@types/node": "26.6.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.7.0",
    "eslint-plugin-boundaries": "7.0.2",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.5",
    "supertest": "7.2.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.63.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.86.0",
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@hono/node-server": "2.1.1",
    "commander": "15.0.0",
    "convict": "6.2.5",
    "graphology": "0.26.0",
    "hono": "4.13.3",
    "pino": "10.3.1",
    "ulid": "3.0.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.4": true,
    "protobufjs@7.6.5": true
  }
}
