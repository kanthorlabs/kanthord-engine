{
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/go:1": { "version": "1.25" },
    "ghcr.io/devcontainers/features/java:1": { "version": "21" }
  },
  "containerEnv": {
    "PATH": "/var/lib/kanthord/.local/bin:${containerEnv:PATH}",
    "GOPATH": "/var/lib/kanthord/go",
    "CARGO_HOME": "/var/lib/kanthord/.cache/cargo"
  },
  "customizations": {
    "kanthord": {
      "checks": [
        "node --version",
        "python --version",
        "go version",
        "java -version"
      ]
    }
  }
}
